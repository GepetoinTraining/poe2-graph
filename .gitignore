__pycache__/
*.pyc
.pytest_cache/
.vs/
.claude/
*.swp
probe_*.html

# Updater working dirs (git clones from upstream forks, regenerable)
atlastree-export/
poe2-skilltree-export/


# Worker + diagnostic logs
*.log

# Note: amulet.json, amulets_modsview.json, endgame-items*.html are tracked
# test fixtures for tests/test_poe2db_client.py — they look like research
# scraps but are load-bearing. Do NOT add ignore patterns for them; git
# preserves tracked files anyway but the pattern is misleading.

# Player data — never tracked
.env
EXILE/PLAYER.md
EXILE/PLAYER.initial.md
EXILE/PLAYER.diffs/
EXILE/LEAGUE_*.md
EXILE/LEAGUE_*.initial.md
EXILE/LEAGUE_*.diffs/
EXILE/CHARACTER_*.md
EXILE/CHARACTER_*.initial.md
EXILE/CHARACTER_*.diffs/
EXILE/CHARACTER_*.build
EXILE/DONE
EXILE/HISTORY.md
data/poe2db_cache/

# Disk-backed caches managed by infra.updater (regenerable on session start)
.cache/

# v2 runtime state — local-only, never tracked
# - .queue/        clipboard listener queue (events awaiting drain into a cycle)
# - poe2_graph.db  unified SQLite store (build/farm/craft/guide graphs)
.queue/
poe2_graph.db
poe2_graph.db-journal
poe2_graph.db-wal
poe2_graph.db-shm

# Pip stdout accidentally captured as a file (e.g. `pip install mcp >=1.27`
# without proper quoting leaves a `=1.27` artifact at root)
=*

# Node modules for electron client

electron/node_modules/
electron/dist
